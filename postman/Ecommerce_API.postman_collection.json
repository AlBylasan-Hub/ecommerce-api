{
  "info": {
    "name": "Ecommerce API",
    "description": "Postman collection for the E-commerce REST API built with Node.js, Express and Neon PostgreSQL. Requests 1-16 are the mandatory tests from the training guide. Requests 17-22 cover the remaining required endpoints.",
